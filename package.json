{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:ts": "pnpm --filter twitch-regex build",
    "build:py": "cd packages/python && .venv/Scripts/flit build --no-use-vcs",
    "build:rs": "cargo build --manifest-path packages/rust/Cargo.toml",
    "publish:py": "cd packages/python && .venv/Scripts/flit publish --no-use-vcs",
    "test:ts": "pnpm --filter twitch-regex test",
    "test:ts:watch": "pnpm --filter twitch-regex test:watch",
    "test:ts:types": "pnpm --filter twitch-regex test:types",
    "test:py": "python -m unittest discover -v -s packages/python/tests",
    "test:rs": "cargo test --manifest-path packages/rust/Cargo.toml",
    "test:go": "GOPROXY=off go -C packages/go test -v ./...",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
