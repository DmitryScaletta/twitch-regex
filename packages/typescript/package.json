{
  "name": "twitch-regex",
  "version": "0.1.3",
  "description": "Regular expressions for twitch clips, videos, channels and collections links",
  "keywords": [
    "regex",
    "regexp",
    "regular expressions",
    "twitch"
  ],
  "bugs": {
    "url": "https://github.com/DmitryScaletta/twitch-regex/issues"
  },
  "license": "MIT",
  "author": "DmitryScaletta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitryScaletta/twitch-regex.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test src/*.test.ts",
    "test:watch": "node --test --watch src/*.test.ts",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3"
  }
}
